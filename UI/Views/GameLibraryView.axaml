<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:cfg="using:Mesen.Config"
	mc:Ignorable="d"
	d:DesignWidth="700"
	d:DesignHeight="500"
	x:Class="Mesen.Views.GameLibraryView"
	x:DataType="vm:GameLibraryViewModel"
	Background="{DynamicResource ThemeBackgroundBrush}"
	Foreground="{DynamicResource ThemeForegroundBrush}"
>
	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
		<Grid ColumnDefinitions="*,Auto,Auto" Margin="0 0 0 10">
			<StackPanel>
				<TextBlock Text="{l:Translate lblGameLibrary}" FontSize="22" FontWeight="SemiBold" />
				<TextBlock Text="{l:Translate lblGameLibraryDescription}" Opacity="0.72" TextWrapping="Wrap" />
			</StackPanel>
			<Button Grid.Column="1" Content="{l:Translate btnRefresh}" Click="BtnRefresh_OnClick" Margin="8 0 0 0" />
			<Button Grid.Column="2" Content="{l:Translate btnAddFolder}" Click="BtnAddFolder_OnClick" Margin="8 0 0 0" />
		</Grid>

		<Border Grid.Row="1" BorderBrush="{DynamicResource MesenGrayBorderColor}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0 0 0 10">
			<StackPanel>
				<CheckBox
					Content="{l:Translate chkRecursiveForNewFolder}"
					IsChecked="{Binding RecursiveForNewFolder}"
					Margin="0 0 0 5"
				/>
				<TextBlock Text="{l:Translate lblNoGameFolders}" Opacity="0.72" IsVisible="{Binding !HasFolders}" />
				<ScrollViewer MaxHeight="100">
					<ItemsControl ItemsSource="{Binding Folders}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="cfg:GameLibraryFolder">
								<Grid ColumnDefinitions="*,Auto,Auto" Margin="0 2">
									<TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
									<CheckBox
										Grid.Column="1"
										Content="{l:Translate chkIncludeSubfolders}"
										IsChecked="{Binding Recursive}"
										Click="FolderRecursive_OnClick"
										Margin="8 0"
									/>
									<Button Grid.Column="2" Content="{l:Translate btnRemove}" Click="BtnRemoveFolder_OnClick" MinWidth="70" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</StackPanel>
		</Border>

		<TextBox
			Grid.Row="2"
			Name="SearchBox"
			Text="{Binding SearchText, Converter={StaticResource NullTextConverter}}"
			PlaceholderText="{l:Translate lblSearchGames}"
			Margin="0 0 0 10"
			GotFocus="SearchBox_OnGotFocus"
			LostFocus="SearchBox_OnLostFocus"
		/>

		<ListBox
			Grid.Row="3"
			Name="GameList"
			ItemsSource="{Binding GameEntries}"
			DoubleTapped="GameList_OnDoubleTapped"
			Background="{DynamicResource ThemeBackgroundBrush}"
			Foreground="{DynamicResource ThemeForegroundBrush}"
		>
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:GameLibraryEntry">
					<Grid ColumnDefinitions="Auto,*,Auto" Margin="5 4">
						<Border Background="#343434" CornerRadius="3" Width="48" Height="48" VerticalAlignment="Center">
							<TextBlock Text="{Binding Format}" Foreground="#8ED8FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<StackPanel Grid.Column="1" Margin="10 0" VerticalAlignment="Center">
							<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							<TextBlock Text="{Binding Location}" Opacity="0.68" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<Button Grid.Column="2" Content="{l:Translate btnPlay}" Click="BtnPlay_OnClick" VerticalAlignment="Center" MinWidth="70" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0 10 0 0">
			<TextBlock Text="{Binding StatusText}" Opacity="0.72" VerticalAlignment="Center" />
			<ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsScanning}" Width="120" />
		</Grid>
	</Grid>
</UserControl>
